# Copy to .env.local. Both values come from the Supabase project's Connect dialog (or MCP
# get_project_url / get_publishable_keys). The publishable key is safe in the browser; never put
# the secret or service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only: the Claude API key that reads uploaded equipment lists (Anthropic Console > API keys). Never a NEXT_PUBLIC_ name.
ANTHROPIC_API_KEY= 

# Only for `npm run test:db` (supabase/tests, every run rolled back). Supabase > Connect > Session pooler
# connection string (port 5432) with the database password. Server-side only: never a NEXT_PUBLIC_ name.
SUPABASE_DB_URL=

# Server-side only: the public address customer links are built from (https://agreements.example.com, no path).
# Optional; unset, the link uses the origin of the request that created it. Not a secret.
APP_BASE_URL=

# Server-side only, all three (outbox-dispatch). Never a NEXT_PUBLIC_ name.
# PORTAL_LINK_KEY: 32 random bytes, base64 (`node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# It seals each customer link so reminders can carry it; without it, Send and "Get a new link" fail.
PORTAL_LINK_KEY=
# RESEND_API_KEY: Resend > API keys, for the account that holds the sending domain. Unset, n8n's callbacks answer 503.
RESEND_API_KEY=
# EMAIL_FROM: the sending address on the verified Resend domain, e.g. agreements@<your domain>. Not a secret.
EMAIL_FROM=

# Server-side only, all three (signature-provider). Never a NEXT_PUBLIC_ name.
# DOCUSEAL_API_KEY: DocuSeal > Settings > API. Unset, "Send for signature" answers "E-signature is not set up".
DOCUSEAL_API_KEY=
# DOCUSEAL_API_URL: https://api.docuseal.com (global cloud) or https://api.docuseal.eu. Not a secret.
DOCUSEAL_API_URL=
# SIGNING_LINK_KEY: 32 random bytes, base64, as PORTAL_LINK_KEY but a different value. It seals the customer's signing link
# and the provider's embed links; without it, "Send for signature" fails before anything is sent.
SIGNING_LINK_KEY=

# Server-side only (billing-checkout). Never a NEXT_PUBLIC_ name.
# STRIPE_SECRET_KEY: Stripe dashboard > Developers > API keys (sk_test_... in test mode). Unset, /register answers "Sign-up isn't open yet".
# Do not set it in production until workspace provisioning ships: a visitor would pay and get no workspace.
STRIPE_SECRET_KEY=
# APP_BASE_URL (above) is also required for Checkout: Stripe sends the visitor back to <APP_BASE_URL>/register/success.
# STRIPE_PUBLISHABLE_KEY: Stripe dashboard > Developers > API keys (pk_test_... in test mode). A publishable key is safe in the browser:
# it lets the embedded card field on /settings/billing talk to Stripe. It is read on the server at request time (no rebuild per
# environment) and is not a NEXT_PUBLIC_ name. Unset, the billing page works but says "Card updates aren't set up yet".
STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY and APP_BASE_URL (above) are also needed by the billing page: without them it says "Billing isn't available yet".

# --- Secrets that are NOT read by the app, and so are not env vars here. Listed so a new machine knows where they live. ---
# Supabase Vault (Dashboard > Database > Vault, or `select vault.create_secret('<value>', '<name>')`; rotate with vault.update_secret):
#   automation_hmac_secret   signs and checks the app <-> n8n callbacks (outbox-dispatch). Same value as __SA_HMAC_SECRET__ in n8n.
#   n8n_events_url           the n8n events webhook address the database posts to.
#   docuseal_webhook_secret  the whsec_... secret of the DocuSeal webhook (DocuSeal console > Settings > Webhooks > the webhook >
#                            Security > HMAC). DocuSeal has no "regenerate": to rotate, create a new webhook with the same URL
#                            (<APP_BASE_URL>/api/webhooks/docuseal; events form.completed, form.declined, submission.completed),
#                            store its secret here, then delete the old webhook.
# n8n (the editor or REST API, never committed): __SA_HMAC_SECRET__ and __SA_APP_BASE_URL__ in automation/n8n/*.json are
# replaced after import. An n8n API key (Settings > n8n API) is only needed to import those files from a shell; create it with
# an expiry, keep it in your shell environment as N8N_API_KEY for that one run, and delete it afterwards.
#   stripe_webhook_secret    the whsec_... signing secret of the Stripe webhook endpoint (Stripe dashboard > Developers > Webhooks,
#                            endpoint <app>/api/webhooks/stripe, events checkout.session.completed, customer.subscription.created/updated/deleted,
#                            invoice.paid, invoice.payment_failed). Without it the endpoint answers 503.
